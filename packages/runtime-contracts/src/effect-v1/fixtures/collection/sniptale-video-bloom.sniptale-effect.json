{
  "schemaVersion": "sniptale.effect.v1",
  "id": "sniptale-video-bloom",
  "kind": "targetEffect",
  "duration": 5,
  "label": {
    "ru": "Мягкое свечение",
    "en": "Soft glow"
  },
  "description": {
    "ru": "Настраиваемая обработка; интенсивность 0 сохраняет исходник.",
    "en": "Adjustable processing; zero intensity preserves the source."
  },
  "assets": [],
  "controls": [
    {
      "id": "strength",
      "kind": "number",
      "label": {
        "ru": "Интенсивность (%)",
        "en": "Intensity (%)"
      },
      "defaultValue": 30,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "edge",
      "kind": "number",
      "label": {
        "ru": "Плавный вход/выход (%)",
        "en": "Soft edges (% duration)"
      },
      "defaultValue": 8,
      "min": 0,
      "max": 40,
      "step": 1
    },
    {
      "id": "radius",
      "kind": "number",
      "label": {
        "ru": "Радиус свечения",
        "en": "Glow radius"
      },
      "defaultValue": 10,
      "min": 2,
      "max": 20,
      "step": 1
    }
  ],
  "layers": [],
  "clips": [],
  "scenes": [
    {
      "id": "main",
      "start": 0,
      "duration": 5
    }
  ],
  "timeline": {
    "phases": [],
    "tracks": []
  },
  "program": {
    "kind": "graph",
    "version": 1,
    "definitions": {
      "s": {
        "op": "div",
        "args": [
          {
            "op": "min",
            "args": [
              {
                "op": "read",
                "path": "width"
              },
              {
                "op": "read",
                "path": "height"
              }
            ]
          },
          720
        ]
      },
      "edge": {
        "op": "max",
        "args": [
          0.0001,
          {
            "op": "div",
            "args": [
              {
                "op": "read",
                "path": "controls.edge"
              },
              100
            ]
          }
        ]
      },
      "envelope": {
        "op": "select",
        "value": {
          "op": "eq",
          "args": [
            {
              "op": "read",
              "path": "controls.edge"
            },
            0
          ]
        },
        "values": [
          1,
          {
            "op": "mul",
            "args": [
              {
                "op": "out",
                "args": [
                  {
                    "op": "clamp",
                    "args": [
                      {
                        "op": "div",
                        "args": [
                          {
                            "op": "read",
                            "path": "progress"
                          },
                          {
                            "op": "read",
                            "path": "defs.edge"
                          }
                        ]
                      },
                      0,
                      1
                    ]
                  }
                ]
              },
              {
                "op": "out",
                "args": [
                  {
                    "op": "clamp",
                    "args": [
                      {
                        "op": "div",
                        "args": [
                          {
                            "op": "sub",
                            "args": [
                              1,
                              {
                                "op": "read",
                                "path": "progress"
                              }
                            ]
                          },
                          {
                            "op": "read",
                            "path": "defs.edge"
                          }
                        ]
                      },
                      0,
                      1
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "amount": {
        "op": "mul",
        "args": [
          {
            "op": "div",
            "args": [
              {
                "op": "read",
                "path": "controls.strength"
              },
              100
            ]
          },
          {
            "op": "read",
            "path": "defs.envelope"
          }
        ]
      }
    },
    "commands": [
      {
        "op": "clear"
      },
      {
        "op": "image",
        "input": "source",
        "x": 0,
        "y": 0,
        "width": {
          "op": "read",
          "path": "width"
        },
        "height": {
          "op": "read",
          "path": "height"
        },
        "fit": "cover"
      },
      {
        "op": "renderPass",
        "id": "glow",
        "width": {
          "op": "div",
          "args": [
            {
              "op": "read",
              "path": "width"
            },
            4
          ]
        },
        "height": {
          "op": "div",
          "args": [
            {
              "op": "read",
              "path": "height"
            },
            4
          ]
        },
        "commands": [
          {
            "op": "group",
            "commands": [
              {
                "op": "image",
                "input": "source",
                "x": 0,
                "y": 0,
                "width": {
                  "op": "read",
                  "path": "width"
                },
                "height": {
                  "op": "read",
                  "path": "height"
                },
                "fit": "cover",
                "filter": {
                  "blur": {
                    "op": "mul",
                    "args": [
                      {
                        "op": "mul",
                        "args": [
                          {
                            "op": "read",
                            "path": "controls.radius"
                          },
                          {
                            "op": "read",
                            "path": "defs.s"
                          }
                        ]
                      },
                      0.25
                    ]
                  }
                }
              }
            ],
            "scaleX": 0.25,
            "scaleY": 0.25
          }
        ]
      },
      {
        "op": "compositePass",
        "passId": "glow",
        "x": 0,
        "y": 0,
        "width": {
          "op": "read",
          "path": "width"
        },
        "height": {
          "op": "read",
          "path": "height"
        },
        "alpha": {
          "op": "mul",
          "args": [
            {
              "op": "read",
              "path": "defs.amount"
            },
            0.4
          ]
        },
        "blend": "screen"
      }
    ]
  }
}
