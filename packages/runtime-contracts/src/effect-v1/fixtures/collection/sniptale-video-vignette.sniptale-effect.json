{
  "schemaVersion": "sniptale.effect.v1",
  "id": "sniptale-video-vignette",
  "kind": "targetEffect",
  "duration": 5,
  "label": {
    "ru": "Виньетка",
    "en": "Vignette"
  },
  "description": {
    "ru": "Настраиваемая обработка; интенсивность 0 сохраняет исходник.",
    "en": "Adjustable processing; zero intensity preserves the source."
  },
  "assets": [],
  "controls": [
    {
      "id": "strength",
      "kind": "number",
      "label": {
        "ru": "Интенсивность (%)",
        "en": "Intensity (%)"
      },
      "defaultValue": 30,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "edge",
      "kind": "number",
      "label": {
        "ru": "Плавный вход/выход (%)",
        "en": "Soft edges (% duration)"
      },
      "defaultValue": 8,
      "min": 0,
      "max": 40,
      "step": 1
    },
    {
      "id": "spread",
      "kind": "number",
      "label": {
        "ru": "Светлая область (%)",
        "en": "Clear center (%)"
      },
      "defaultValue": 45,
      "min": 15,
      "max": 80,
      "step": 1
    },
    {
      "id": "focusX",
      "kind": "number",
      "label": {
        "ru": "Центр X (%)",
        "en": "Center X (%)"
      },
      "defaultValue": 50,
      "min": 20,
      "max": 80,
      "step": 1
    },
    {
      "id": "focusY",
      "kind": "number",
      "label": {
        "ru": "Центр Y (%)",
        "en": "Center Y (%)"
      },
      "defaultValue": 50,
      "min": 20,
      "max": 80,
      "step": 1
    }
  ],
  "layers": [],
  "clips": [],
  "scenes": [
    {
      "id": "main",
      "start": 0,
      "duration": 5
    }
  ],
  "timeline": {
    "phases": [],
    "tracks": []
  },
  "program": {
    "kind": "graph",
    "version": 1,
    "definitions": {
      "s": {
        "op": "div",
        "args": [
          {
            "op": "min",
            "args": [
              {
                "op": "read",
                "path": "width"
              },
              {
                "op": "read",
                "path": "height"
              }
            ]
          },
          720
        ]
      },
      "edge": {
        "op": "max",
        "args": [
          0.0001,
          {
            "op": "div",
            "args": [
              {
                "op": "read",
                "path": "controls.edge"
              },
              100
            ]
          }
        ]
      },
      "envelope": {
        "op": "select",
        "value": {
          "op": "eq",
          "args": [
            {
              "op": "read",
              "path": "controls.edge"
            },
            0
          ]
        },
        "values": [
          1,
          {
            "op": "mul",
            "args": [
              {
                "op": "out",
                "args": [
                  {
                    "op": "clamp",
                    "args": [
                      {
                        "op": "div",
                        "args": [
                          {
                            "op": "read",
                            "path": "progress"
                          },
                          {
                            "op": "read",
                            "path": "defs.edge"
                          }
                        ]
                      },
                      0,
                      1
                    ]
                  }
                ]
              },
              {
                "op": "out",
                "args": [
                  {
                    "op": "clamp",
                    "args": [
                      {
                        "op": "div",
                        "args": [
                          {
                            "op": "sub",
                            "args": [
                              1,
                              {
                                "op": "read",
                                "path": "progress"
                              }
                            ]
                          },
                          {
                            "op": "read",
                            "path": "defs.edge"
                          }
                        ]
                      },
                      0,
                      1
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "amount": {
        "op": "mul",
        "args": [
          {
            "op": "div",
            "args": [
              {
                "op": "read",
                "path": "controls.strength"
              },
              100
            ]
          },
          {
            "op": "read",
            "path": "defs.envelope"
          }
        ]
      }
    },
    "commands": [
      {
        "op": "clear"
      },
      {
        "op": "image",
        "input": "source",
        "x": 0,
        "y": 0,
        "width": {
          "op": "read",
          "path": "width"
        },
        "height": {
          "op": "read",
          "path": "height"
        },
        "fit": "cover"
      },
      {
        "op": "group",
        "commands": [
          {
            "op": "fillRect",
            "x": 0,
            "y": 0,
            "width": 1,
            "height": 1,
            "fill": {
              "kind": "radialGradient",
              "x0": {
                "op": "div",
                "args": [
                  {
                    "op": "read",
                    "path": "controls.focusX"
                  },
                  100
                ]
              },
              "y0": {
                "op": "div",
                "args": [
                  {
                    "op": "read",
                    "path": "controls.focusY"
                  },
                  100
                ]
              },
              "r0": {
                "op": "mul",
                "args": [
                  {
                    "op": "div",
                    "args": [
                      {
                        "op": "read",
                        "path": "controls.spread"
                      },
                      100
                    ]
                  },
                  0.5
                ]
              },
              "x1": {
                "op": "div",
                "args": [
                  {
                    "op": "read",
                    "path": "controls.focusX"
                  },
                  100
                ]
              },
              "y1": {
                "op": "div",
                "args": [
                  {
                    "op": "read",
                    "path": "controls.focusY"
                  },
                  100
                ]
              },
              "r1": 0.85,
              "stops": [
                {
                  "offset": 0,
                  "color": "#00000000"
                },
                {
                  "offset": 1,
                  "color": "#000000"
                }
              ]
            },
            "alpha": {
              "op": "mul",
              "args": [
                {
                  "op": "read",
                  "path": "defs.amount"
                },
                0.85
              ]
            }
          }
        ],
        "scaleX": {
          "op": "read",
          "path": "width"
        },
        "scaleY": {
          "op": "read",
          "path": "height"
        }
      }
    ]
  }
}
