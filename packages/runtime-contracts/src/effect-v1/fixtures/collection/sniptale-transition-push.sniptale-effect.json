{
  "schemaVersion": "sniptale.effect.v1",
  "id": "sniptale-transition-push",
  "kind": "transition",
  "duration": 0.8,
  "label": {
    "ru": "Сдвиг",
    "en": "Push"
  },
  "description": {
    "ru": "Переход с точными начальным и конечным кадрами.",
    "en": "A transition with exact start and end frames."
  },
  "assets": [],
  "controls": [
    {
      "id": "curve",
      "kind": "number",
      "label": {
        "ru": "Плавность (%)",
        "en": "Easing (%)"
      },
      "defaultValue": 85,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "direction",
      "kind": "number",
      "label": {
        "ru": "Направление (0: ←, 1: →, 2: ↑, 3: ↓)",
        "en": "Direction (0: ←, 1: →, 2: ↑, 3: ↓)"
      },
      "defaultValue": 0,
      "min": 0,
      "max": 3,
      "step": 1
    }
  ],
  "layers": [],
  "clips": [],
  "scenes": [
    {
      "id": "main",
      "start": 0,
      "duration": 0.8
    }
  ],
  "timeline": {
    "phases": [],
    "tracks": []
  },
  "program": {
    "kind": "graph",
    "version": 1,
    "definitions": {
      "s": {
        "op": "div",
        "args": [
          {
            "op": "min",
            "args": [
              {
                "op": "read",
                "path": "width"
              },
              {
                "op": "read",
                "path": "height"
              }
            ]
          },
          720
        ]
      },
      "q": {
        "op": "mix",
        "args": [
          {
            "op": "read",
            "path": "progress"
          },
          {
            "op": "inOut",
            "args": [
              {
                "op": "read",
                "path": "progress"
              }
            ]
          },
          {
            "op": "div",
            "args": [
              {
                "op": "read",
                "path": "controls.curve"
              },
              100
            ]
          }
        ]
      },
      "pulse": {
        "op": "mul",
        "args": [
          4,
          {
            "op": "read",
            "path": "defs.q"
          },
          {
            "op": "sub",
            "args": [
              1,
              {
                "op": "read",
                "path": "defs.q"
              }
            ]
          }
        ]
      },
      "direction": {
        "op": "clamp",
        "args": [
          {
            "op": "floor",
            "args": [
              {
                "op": "read",
                "path": "controls.direction"
              }
            ]
          },
          0,
          3
        ]
      },
      "dx": {
        "op": "select",
        "value": {
          "op": "lt",
          "args": [
            {
              "op": "read",
              "path": "defs.direction"
            },
            2
          ]
        },
        "values": [
          {
            "op": "select",
            "value": {
              "op": "eq",
              "args": [
                {
                  "op": "read",
                  "path": "defs.direction"
                },
                0
              ]
            },
            "values": [-1, 1]
          },
          0
        ]
      },
      "dy": {
        "op": "select",
        "value": {
          "op": "gte",
          "args": [
            {
              "op": "read",
              "path": "defs.direction"
            },
            2
          ]
        },
        "values": [
          {
            "op": "select",
            "value": {
              "op": "eq",
              "args": [
                {
                  "op": "read",
                  "path": "defs.direction"
                },
                2
              ]
            },
            "values": [-1, 1]
          },
          0
        ]
      }
    },
    "commands": [
      {
        "op": "clear"
      },
      {
        "op": "group",
        "commands": [
          {
            "op": "image",
            "input": "from",
            "x": 0,
            "y": 0,
            "width": {
              "op": "read",
              "path": "width"
            },
            "height": {
              "op": "read",
              "path": "height"
            },
            "fit": "cover"
          }
        ],
        "x": {
          "op": "mul",
          "args": [
            {
              "op": "read",
              "path": "width"
            },
            {
              "op": "read",
              "path": "defs.q"
            },
            {
              "op": "read",
              "path": "defs.dx"
            }
          ]
        },
        "y": {
          "op": "mul",
          "args": [
            {
              "op": "read",
              "path": "height"
            },
            {
              "op": "read",
              "path": "defs.q"
            },
            {
              "op": "read",
              "path": "defs.dy"
            }
          ]
        }
      },
      {
        "op": "group",
        "commands": [
          {
            "op": "image",
            "input": "to",
            "x": 0,
            "y": 0,
            "width": {
              "op": "read",
              "path": "width"
            },
            "height": {
              "op": "read",
              "path": "height"
            },
            "fit": "cover"
          }
        ],
        "x": {
          "op": "mul",
          "args": [
            {
              "op": "read",
              "path": "width"
            },
            {
              "op": "sub",
              "args": [
                {
                  "op": "read",
                  "path": "defs.q"
                },
                1
              ]
            },
            {
              "op": "read",
              "path": "defs.dx"
            }
          ]
        },
        "y": {
          "op": "mul",
          "args": [
            {
              "op": "read",
              "path": "height"
            },
            {
              "op": "sub",
              "args": [
                {
                  "op": "read",
                  "path": "defs.q"
                },
                1
              ]
            },
            {
              "op": "read",
              "path": "defs.dy"
            }
          ]
        }
      }
    ]
  }
}
