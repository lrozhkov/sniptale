{
  "schemaVersion": "sniptale.effect.v1",
  "id": "sniptale-frame",
  "kind": "standalone",
  "duration": 4,
  "label": {
    "ru": "Контур",
    "en": "Outline"
  },
  "description": {
    "ru": "Выделение области с независимой толщиной контура и безопасным положением.",
    "en": "An area highlight with independent stroke width and safe positioning."
  },
  "assets": [],
  "controls": [
    {
      "id": "accent",
      "kind": "color",
      "label": {
        "ru": "Акцент",
        "en": "Accent"
      },
      "defaultValue": "#fb923c",
      "group": "appearance",
      "order": 0
    },
    {
      "id": "surface",
      "kind": "color",
      "label": {
        "ru": "Подложка",
        "en": "Surface"
      },
      "defaultValue": "#16181d",
      "group": "appearance",
      "order": 1
    },
    {
      "id": "line",
      "kind": "number",
      "label": {
        "ru": "Толщина линии",
        "en": "Stroke width"
      },
      "defaultValue": 3,
      "min": 1,
      "max": 8,
      "step": 1,
      "group": "appearance",
      "order": 2
    },
    {
      "id": "entry",
      "kind": "number",
      "label": {
        "ru": "Вход (% длительности)",
        "en": "Entrance (% duration)"
      },
      "defaultValue": 18,
      "min": 5,
      "max": 40,
      "step": 1,
      "group": "animation",
      "order": 3
    }
  ],
  "layers": [],
  "clips": [],
  "scenes": [
    {
      "id": "main",
      "start": 0,
      "duration": 4
    }
  ],
  "timeline": {
    "phases": [],
    "tracks": []
  },
  "program": {
    "kind": "graph",
    "version": 1,
    "definitions": {
      "s": 1,
      "entry": {
        "op": "max",
        "args": [
          0.0001,
          {
            "op": "div",
            "args": [
              {
                "op": "read",
                "path": "controls.entry"
              },
              100
            ]
          }
        ]
      },
      "en": {
        "op": "out",
        "args": [
          {
            "op": "clamp",
            "args": [
              {
                "op": "div",
                "args": [
                  {
                    "op": "read",
                    "path": "progress"
                  },
                  {
                    "op": "read",
                    "path": "defs.entry"
                  }
                ]
              },
              0,
              1
            ]
          }
        ]
      },
      "exit": {
        "op": "out",
        "args": [
          {
            "op": "clamp",
            "args": [
              {
                "op": "div",
                "args": [
                  {
                    "op": "sub",
                    "args": [
                      1,
                      {
                        "op": "read",
                        "path": "progress"
                      }
                    ]
                  },
                  0.1
                ]
              },
              0,
              1
            ]
          }
        ]
      },
      "bw": {
        "op": "sub",
        "args": [
          {
            "op": "read",
            "path": "width"
          },
          {
            "op": "read",
            "path": "defs.stroke"
          }
        ]
      },
      "bh": {
        "op": "sub",
        "args": [
          {
            "op": "read",
            "path": "height"
          },
          {
            "op": "read",
            "path": "defs.stroke"
          }
        ]
      },
      "px": {
        "op": "div",
        "args": [
          {
            "op": "read",
            "path": "defs.stroke"
          },
          2
        ]
      },
      "py": {
        "op": "div",
        "args": [
          {
            "op": "read",
            "path": "defs.stroke"
          },
          2
        ]
      },
      "stroke": {
        "op": "min",
        "args": [
          {
            "op": "add",
            "args": [
              {
                "op": "read",
                "path": "controls.line"
              },
              3
            ]
          },
          {
            "op": "div",
            "args": [
              {
                "op": "min",
                "args": [
                  {
                    "op": "read",
                    "path": "width"
                  },
                  {
                    "op": "read",
                    "path": "height"
                  }
                ]
              },
              2
            ]
          }
        ]
      }
    },
    "commands": [
      {
        "op": "clear"
      },
      {
        "op": "group",
        "commands": [
          {
            "op": "polyline",
            "points": [
              {
                "x": 0,
                "y": 0
              },
              {
                "x": {
                  "op": "read",
                  "path": "defs.bw"
                },
                "y": 0
              },
              {
                "x": {
                  "op": "read",
                  "path": "defs.bw"
                },
                "y": {
                  "op": "read",
                  "path": "defs.bh"
                }
              },
              {
                "x": 0,
                "y": {
                  "op": "read",
                  "path": "defs.bh"
                }
              },
              {
                "x": 0,
                "y": 0
              }
            ],
            "stroke": {
              "op": "read",
              "path": "controls.surface"
            },
            "lineWidth": {
              "op": "min",
              "args": [
                {
                  "op": "add",
                  "args": [
                    {
                      "op": "mul",
                      "args": [
                        {
                          "op": "read",
                          "path": "controls.line"
                        },
                        {
                          "op": "read",
                          "path": "defs.s"
                        }
                      ]
                    },
                    {
                      "op": "mul",
                      "args": [
                        3,
                        {
                          "op": "read",
                          "path": "defs.s"
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "read",
                  "path": "defs.stroke"
                }
              ]
            },
            "lineCap": "round",
            "lineJoin": "round",
            "progress": {
              "op": "read",
              "path": "defs.en"
            }
          },
          {
            "op": "polyline",
            "points": [
              {
                "x": 0,
                "y": 0
              },
              {
                "x": {
                  "op": "read",
                  "path": "defs.bw"
                },
                "y": 0
              },
              {
                "x": {
                  "op": "read",
                  "path": "defs.bw"
                },
                "y": {
                  "op": "read",
                  "path": "defs.bh"
                }
              },
              {
                "x": 0,
                "y": {
                  "op": "read",
                  "path": "defs.bh"
                }
              },
              {
                "x": 0,
                "y": 0
              }
            ],
            "stroke": {
              "op": "read",
              "path": "controls.accent"
            },
            "lineWidth": {
              "op": "min",
              "args": [
                {
                  "op": "mul",
                  "args": [
                    {
                      "op": "read",
                      "path": "controls.line"
                    },
                    {
                      "op": "read",
                      "path": "defs.s"
                    }
                  ]
                },
                {
                  "op": "read",
                  "path": "defs.stroke"
                }
              ]
            },
            "lineCap": "round",
            "lineJoin": "round",
            "progress": {
              "op": "read",
              "path": "defs.en"
            }
          }
        ],
        "x": {
          "op": "read",
          "path": "defs.px"
        },
        "y": {
          "op": "read",
          "path": "defs.py"
        },
        "alpha": {
          "op": "mul",
          "args": [
            {
              "op": "out",
              "args": [
                {
                  "op": "clamp",
                  "args": [
                    {
                      "op": "div",
                      "args": [
                        {
                          "op": "sub",
                          "args": [
                            {
                              "op": "read",
                              "path": "progress"
                            },
                            {
                              "op": "mul",
                              "args": [
                                {
                                  "op": "read",
                                  "path": "defs.entry"
                                },
                                0
                              ]
                            }
                          ]
                        },
                        {
                          "op": "mul",
                          "args": [
                            {
                              "op": "read",
                              "path": "defs.entry"
                            },
                            1
                          ]
                        }
                      ]
                    },
                    0,
                    1
                  ]
                }
              ]
            },
            {
              "op": "read",
              "path": "defs.exit"
            }
          ]
        }
      }
    ]
  },
  "objectLayout": {
    "width": 640,
    "height": 280,
    "resize": "reflow"
  },
  "controlPresets": [
    {
      "id": "sniptale-orange-dark",
      "label": {
        "en": "Dark",
        "ru": "Тёмный"
      },
      "theme": {
        "id": "sniptale-orange",
        "label": {
          "en": "Sniptale Orange",
          "ru": "Sniptale Orange"
        }
      },
      "style": {
        "id": "dark",
        "label": {
          "en": "Dark",
          "ru": "Тёмный"
        }
      },
      "values": {
        "accent": "#fb923c",
        "surface": "#16181d",
        "line": 3
      }
    },
    {
      "id": "sniptale-orange-light",
      "label": {
        "en": "Light",
        "ru": "Светлый"
      },
      "theme": {
        "id": "sniptale-orange",
        "label": {
          "en": "Sniptale Orange",
          "ru": "Sniptale Orange"
        }
      },
      "style": {
        "id": "light",
        "label": {
          "en": "Light",
          "ru": "Светлый"
        }
      },
      "values": {
        "accent": "#c2410c",
        "surface": "#fffaf4",
        "line": 3
      }
    }
  ],
  "defaultControlPresetId": "sniptale-orange-dark"
}
