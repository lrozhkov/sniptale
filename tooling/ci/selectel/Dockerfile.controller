FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY tooling/configs/ci/openstack-controller-requirements.lock /tmp/requirements.lock
COPY tooling/configs/ci/toolchain.lock.json /tmp/toolchain.lock.json
RUN python -c 'import hashlib,json; lock=json.load(open("/tmp/toolchain.lock.json")); data=open("/tmp/requirements.lock","rb").read(); assert hashlib.sha256(data).hexdigest() == lock["openstackController"]["requirementsSha256"]' \
    && python -m pip install --no-cache-dir --require-hashes --only-binary=:all: --requirement /tmp/requirements.lock \
    && python -c 'import importlib.metadata,json; lock=json.load(open("/tmp/toolchain.lock.json")); assert importlib.metadata.version("openstacksdk") == lock["openstackController"]["openstacksdkVersion"]' \
    && rm /tmp/requirements.lock /tmp/toolchain.lock.json

COPY tooling/ci/selectel/sdk-controller.py /opt/sniptale/sdk-controller.py
ENTRYPOINT ["python", "/opt/sniptale/sdk-controller.py"]
