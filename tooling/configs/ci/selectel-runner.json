{
  "$comment": "Canonical bounded manifest for disposable Selectel GitHub Actions runners. Secret values are never serialized.",
  "schemaVersion": 1,
  "artifactKind": "sniptale-selectel-runner-policy",
  "environment": "selectel-runner-controller",
  "repository": "lrozhkov/sniptale",
  "owners": {
    "controller": "tooling/ci/selectel/sdk-controller.py",
    "controllerImage": "tooling/ci/selectel/Dockerfile.controller",
    "canonicalSemantics": "tooling/ci/container.mjs",
    "canonicalProofWorkflow": ".github/workflows/_canonical-proof.yml",
    "prWorkflow": ".github/workflows/pr.yml",
    "provenanceWorkflow": ".github/workflows/provenance.yml",
    "smokeWorkflow": ".github/workflows/selectel-smoke.yml",
    "maintenanceWorkflow": ".github/workflows/selectel-maintenance.yml",
    "releaseWorkflow": ".github/workflows/release.yml"
  },
  "infrastructureSmoke": {
    "workflowOption": "selectel-smoke",
    "profileVariable": "SELECTEL_QA_PROFILES",
    "runsCanonicalQa": false,
    "requiredChecks": [
      "immutable-image-present",
      "locked-toolchain",
      "playwright-chromium",
      "container-metadata-denied",
      "complete-cleanup"
    ]
  },
  "controllerEnvironment": {
    "secrets": [
      "SELECTEL_OS_APPLICATION_CREDENTIAL_ID",
      "SELECTEL_OS_APPLICATION_CREDENTIAL_SECRET",
      "RUNNER_CONTROLLER_TOKEN"
    ],
    "variables": [
      "SELECTEL_OS_AUTH_URL",
      "SELECTEL_OS_REGION_NAME",
      "SELECTEL_QA_PROFILES",
      "SELECTEL_RELEASE_PROFILES"
    ],
    "expectedProjectSha256": "1047ca5188dc076a7604ee16e568fdc75ae30f389199d1ba662407de70a187a0",
    "expectedRegion": "ru-3"
  },
  "runner": {
    "version": "2.336.0",
    "archive": "actions-runner-linux-x64-2.336.0.tar.gz",
    "url": "https://github.com/actions/runner/releases/download/v2.336.0/actions-runner-linux-x64-2.336.0.tar.gz",
    "sha256": "04cf0be1aff4c3ec3554466c39124ca250e3effd8873bb7e8d68535aa9505d5d",
    "labelPrefix": "sniptale-qa-",
    "workFolder": "_work",
    "maxJobs": 1,
    "onlineTimeoutSeconds": 600
  },
  "compute": {
    "operatingSystem": "Ubuntu 24.04 LTS",
    "architecture": "x86_64",
    "publicIp": false,
    "ingress": false,
    "preemptible": true,
    "computeApiVersion": "2.72"
  },
  "imageSelector": {
    "name": "Ubuntu 24.04 LTS 64-bit"
  },
  "quotaCeiling": {
    "vcpus": 32,
    "ramMiB": 65536,
    "volumeGiB": 260
  },
  "network": {
    "subnetCidr": "10.77.0.0/24",
    "lifecycle": "disposable-per-attempt",
    "securityGroupNamePrefix": "sniptale-github-actions-no-ingress"
  },
  "lifecycle": {
    "maxProfiles": 10,
    "serverCreateReconciliation": { "attempts": 6, "intervalSeconds": 5 },
    "ttlSeconds": 10800,
    "nameTemplate": "sniptale-<run-id>-<attempt>",
    "requiredMetadata": [
      "managed-by",
      "repository",
      "workflow",
      "run-id",
      "run-attempt",
      "candidate-sha",
      "expires-at"
    ],
    "managedBy": "sniptale-github-actions"
  },
  "trust": {
    "candidateReceivesControllerSecrets": false,
    "candidateControlsAreBlocking": true,
    "jitConfigRetained": false,
    "releaseSigningKeyOnRunner": false,
    "persistentGhcrCredentialOnRunner": false,
    "persistentNetworkResources": false,
    "sshKeyOnRunner": false
  },
  "artifacts": {
    "prRetentionDays": 14,
    "mainRetentionDays": 30,
    "forbidden": [
      "encoded-jit-config",
      "openstack-credentials",
      "controller-token",
      "raw-cloud-init",
      "codeql-database",
      "engine-cache",
      "raw-engine-temporary-files"
    ]
  },
  "rollback": "Disable Selectel jobs in the two existing workflows, run cleanup --all-managed, delete offline managed JIT registrations, and restore the preceding workflow commit.",
  "collisionCheck": "Names are unique per run-id and attempt; any existing server, volume, port, or runner with that identity is rejected unless cleanup proves it belongs to the same expired controller record.",
  "negativeProof": [
    "invalid-credential",
    "wrong-project-or-region",
    "insufficient-quota",
    "name-collision",
    "missing-preemptible-tag",
    "jit-timeout",
    "cloud-init-failure",
    "runner-loss",
    "in-job-infrastructure-fallback",
    "ambiguous-server-create-response",
    "genuine-qa-failure-no-retry",
    "post-online-qa-failure-no-fallback",
    "cleanup-failure",
    "router-interface-cleanup-failure",
    "router-cleanup-failure",
    "expired-resource-sweep",
    "foreign-resource-preservation",
    "controller-secret-non-propagation",
    "jit-config-non-retention"
  ]
}
