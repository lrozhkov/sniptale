{
  "schemaVersion": 1,
  "repository": "lrozhkov/sniptale",
  "releasePublisher": "lrozhkov",
  "rulesetId": 19212699,
  "actions": {
    "enabled": true,
    "allowed_actions": "selected",
    "sha_pinning_required": true,
    "selected": {
      "github_owned_allowed": true,
      "verified_allowed": false,
      "patterns_allowed": [
        "docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069",
        "docker/login-action@dbcb813823bdd20940b903addbd779551569679f",
        "docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc",
        "coverallsapp/github-action@8d6379e14d29928660c4ba802d8e85393440b329"
      ]
    },
    "workflow": {
      "default_workflow_permissions": "read",
      "can_approve_pull_request_reviews": false
    }
  },
  "security": {
    "vulnerabilityAlerts": true,
    "automatedSecurityFixes": false,
    "privateVulnerabilityReporting": true,
    "immutableReleases": true
  },
  "environments": {
    "selectel-runner-controller": {
      "protected_branches": false,
      "custom_branch_policies": true,
      "branches": ["main"]
    },
    "release-publisher": {
      "protected_branches": false,
      "custom_branch_policies": true,
      "branches": ["main"]
    }
  },
  "ruleset": {
    "name": "Protect main",
    "target": "branch",
    "enforcement": "active",
    "bypassOwner": { "login": "lrozhkov", "mode": "pull_request" },
    "conditions": { "ref_name": { "exclude": [], "include": ["~DEFAULT_BRANCH"] } },
    "rules": [
      { "type": "deletion" },
      { "type": "non_fast_forward" },
      { "type": "required_linear_history" },
      {
        "type": "pull_request",
        "parameters": {
          "required_approving_review_count": 0,
          "dismiss_stale_reviews_on_push": false,
          "required_reviewers": [],
          "require_code_owner_review": false,
          "require_last_push_approval": false,
          "required_review_thread_resolution": true,
          "allowed_merge_methods": ["squash"]
        }
      },
      {
        "type": "required_status_checks",
        "parameters": {
          "strict_required_status_checks_policy": true,
          "do_not_enforce_on_create": true,
          "required_status_checks": [{ "context": "pr-gate", "integration_id": 15368 }]
        }
      }
    ]
  },
  "releaseTagRuleset": {
    "name": "Protect immutable release tags",
    "target": "tag",
    "enforcement": "active",
    "bypass_actors": [],
    "conditions": { "ref_name": { "exclude": [], "include": ["refs/tags/v*"] } },
    "rules": [
      { "type": "update", "parameters": { "update_allows_fetch_and_merge": false } },
      { "type": "deletion" }
    ]
  }
}
