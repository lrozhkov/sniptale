{
  "minTokens": 60,
  "minLines": 5,
  "maxLines": 10000,
  "maxSize": "1mb",
  "mode": "mild",
  "format": [
    "javascript",
    "jsx",
    "typescript",
    "tsx",
    "css",
    "scss",
    "less",
    "html",
    "bash",
    "yaml"
  ],
  "crossFormats": [],
  "formatsExts": {},
  "formatsNames": {},
  "threshold": 0,
  "exitCode": 1,
  "reporters": ["json"],
  "output": ".tmp/jscpd",
  "silent": true,
  "noTips": true,
  "gitignore": true,
  "followSymlinks": false,
  "absolute": true,
  "ignoreCase": false,
  "blame": false,
  "skipLocal": false,
  "skipIsolated": [],
  "ignorePattern": [],
  "ignore": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.test-support.*",
    "**/*.test-helpers.*",
    "**/test-support.*",
    "**/test-support/**",
    "**/*.data.*",
    "**/*.constants.*",
    "**/*.json",
    "**/tooling/test/**",
    "docs/**",
    "tests/**",
    "test/**",
    "node_modules/**",
    ".playwright-browsers/**",
    ".tmp/**",
    "coverage/**",
    "dist/**",
    "**/apps/extension/src/platform/i18n/**"
  ]
}
