    "tooling/qa/audits/codeql-baseline.mjs",
    "tooling/qa/audits/codeql.mjs",
    "tooling/qa/audits/result-contract.mjs",
    "tooling/qa/codeql/codeql-pack.lock.yml",
    "tooling/qa/codeql/config.mjs",
    "tooling/qa/codeql/qlpack.yml",
    "tooling/qa/codeql/sniptale-custom.qls",
    "tooling/qa/core/codeql-proof.mjs",
    "tooling/qa/policy/external-tools.mjs",
    "tooling/qa/tools/tool-cli.mjs"
