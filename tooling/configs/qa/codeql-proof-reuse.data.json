  "modes": {
    "local": "validated local receipt and SARIF or complete CodeQL fallback",
    "candidate": "validated read-only successful-main receipt and SARIF or complete CodeQL fallback"
  },
  "proof": "Only a successful complete CodeQL run may write the receipt; every consumer recomputes the production-source, query-pack, configuration, baseline, toolchain, and image digest.",
  "rollback": "Delete the disposable receipt or omit its read-only CI mounts to force a complete CodeQL run.",
  "collisionCheck": "Atomic replacement is limited to the canonical disposable proof path; immutable CI artifacts retain receipt and SARIF SHA-256 values."
}
