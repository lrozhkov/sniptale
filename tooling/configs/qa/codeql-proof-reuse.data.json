  "controlFiles": [
    "tooling/configs/ci/toolchain.lock.json",
    "tooling/configs/qa/codeql-baseline.json",
    "tooling/configs/qa/codeql-config.yml",
    "tooling/configs/qa/codeql-proof-reuse.data.json",
