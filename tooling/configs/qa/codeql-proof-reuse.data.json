    "tooling/qa/audits",
    "tooling/qa/codeql",
    "tooling/qa/guards/security",
    "tooling/release"
  ],
  "sourceExtensions": [".cjs", ".js", ".jsx", ".mjs", ".ts", ".tsx"],
  "excludedDirectoryNames": [
    ".tmp",
    "__generated__",
    "build",
    "dist",
    "fixture",
    "fixtures",
    "generated",
    "node_modules",
    "test",
    "tests"
  ],
  "excludedFileMarkers": [".data.", ".generated.", ".spec.", ".test."],
