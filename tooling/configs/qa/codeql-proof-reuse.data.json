{
  "schemaVersion": 1,
  "artifactKind": "sniptale-codeql-proof-reuse-policy",
  "proofPath": ".tmp/qa/codeql-proof.json",
  "sarifPath": ".tmp/codeql/results.filtered.sarif",
  "configPath": "tooling/configs/qa/codeql-config.yml",
