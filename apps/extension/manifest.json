{
  "manifest_version": 3,
  "name": "Sniptale",
  "version": "0.4.0",
  "version_name": "0.4.0 alpha",
  "minimum_chrome_version": "148",
  "description": "Workspace for capturing, understanding, annotating, recording, editing, and exporting the web.",
  "default_locale": "en",
  "incognito": "not_allowed",
  "permissions": [
    "storage",
    "contextMenus",
    "unlimitedStorage",
    "tabs",
    "webNavigation",
    "system.display",
    "activeTab",
    "scripting",
    "downloads",
    "offscreen",
    "tabCapture",
    "desktopCapture",
    "clipboardWrite",
    "declarativeNetRequest"
  ],
  "optional_permissions": ["nativeMessaging"],
  "optional_host_permissions": ["<all_urls>", "file:///"],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/manrope-cyrillic-wght-normal.woff2",
        "fonts/manrope-latin-ext-wght-normal.woff2",
        "fonts/manrope-latin-wght-normal.woff2",
        "fonts/marck-script-cyrillic-400-normal.woff2",
        "fonts/marck-script-latin-400-normal.woff2"
      ],
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "use_dynamic_url": true
    }
  ],
  "background": {
    "service_worker": "apps/extension/src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "apps/extension/src/popup/index.html",
    "default_title": "Open Sniptale"
  },
  "commands": {
    "tools-open": { "description": "__MSG_command_tools_open__" },
    "tools-drawing": { "description": "__MSG_command_tools_drawing__" },
    "tools-annotations": { "description": "__MSG_command_tools_annotations__" },
    "tools-quick-edit": { "description": "__MSG_command_tools_quick_edit__" },
    "tools-design-review": { "description": "__MSG_command_tools_design_review__" },
    "tools-video-recording": { "description": "__MSG_command_tools_video_recording__" },
    "capture-visible": { "description": "__MSG_command_capture_visible__" },
    "capture-full-page": { "description": "__MSG_command_capture_full_page__" },
    "capture-selection": { "description": "__MSG_command_capture_selection__" },
    "capture-visible-edit": { "description": "__MSG_command_capture_visible_edit__" },
    "capture-visible-copy": { "description": "__MSG_command_capture_visible_copy__" },
    "capture-desktop-edit": { "description": "__MSG_command_capture_desktop_edit__" },
    "export-current-tab": { "description": "__MSG_command_export_current_tab__" },
    "open-library": { "description": "__MSG_command_open_library__" },
    "open-image-editor": { "description": "__MSG_command_open_image_editor__" },
    "open-video-editor": { "description": "__MSG_command_open_video_editor__" },
    "open-scenario-editor": { "description": "__MSG_command_open_scenario_editor__" }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'none'; worker-src blob:; child-src 'none'; object-src 'none';"
  },
  "sandbox": {
    "pages": ["apps/extension/src/effect-runtime-sandbox/index.html"]
  }
}
