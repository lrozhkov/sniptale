{
  "schemaVersion": "sniptale.effect.v1",
  "id": "sniptale-transition-zoom",
  "kind": "transition",
  "duration": 0.8,
  "label": {
    "ru": "Плавный зум",
    "en": "Smooth zoom"
  },
  "description": {
    "ru": "Переход с точными начальным и конечным кадрами.",
    "en": "A transition with exact start and end frames."
  },
  "assets": [],
  "controls": [
    {
      "id": "curve",
      "kind": "number",
      "label": {
        "ru": "Плавность (%)",
        "en": "Easing (%)"
      },
      "defaultValue": 85,
      "min": 0,
      "max": 100,
      "step": 1,
      "group": "animation",
      "order": 0
    },
    {
      "id": "strength",
      "kind": "number",
      "label": {
        "ru": "Приближение (%)",
        "en": "Zoom (%)"
      },
      "defaultValue": 12,
      "min": 0,
      "max": 30,
      "step": 1,
      "group": "processing",
      "order": 1
    },
    {
      "id": "focusX",
      "kind": "number",
      "label": {
        "ru": "Центр X (%)",
        "en": "Focus X (%)"
      },
      "defaultValue": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "group": "geometry",
      "order": 2
    },
    {
      "id": "focusY",
      "kind": "number",
      "label": {
        "ru": "Центр Y (%)",
        "en": "Focus Y (%)"
      },
      "defaultValue": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "group": "geometry",
      "order": 3
    }
  ],
  "layers": [],
  "clips": [],
  "scenes": [
    {
      "id": "main",
      "start": 0,
      "duration": 0.8
    }
  ],
  "timeline": {
    "phases": [],
    "tracks": []
  },
  "program": {
    "kind": "graph",
    "version": 1,
    "definitions": {
      "q": {
        "op": "mix",
        "args": [
          {
            "op": "read",
            "path": "progress"
          },
          {
            "op": "inOut",
            "args": [
              {
                "op": "read",
                "path": "progress"
              }
            ]
          },
          {
            "op": "div",
            "args": [
              {
                "op": "read",
                "path": "controls.curve"
              },
              100
            ]
          }
        ]
      },
      "pulse": {
        "op": "mul",
        "args": [
          4,
          {
            "op": "read",
            "path": "defs.q"
          },
          {
            "op": "sub",
            "args": [
              1,
              {
                "op": "read",
                "path": "defs.q"
              }
            ]
          }
        ]
      },
      "z": {
        "op": "add",
        "args": [
          1,
          {
            "op": "mul",
            "args": [
              {
                "op": "div",
                "args": [
                  {
                    "op": "read",
                    "path": "controls.strength"
                  },
                  100
                ]
              },
              {
                "op": "read",
                "path": "defs.pulse"
              }
            ]
          }
        ]
      }
    },
    "commands": [
      {
        "op": "clear"
      },
      {
        "op": "group",
        "commands": [
          {
            "op": "image",
            "input": "from",
            "x": 0,
            "y": 0,
            "width": {
              "op": "read",
              "path": "width"
            },
            "height": {
              "op": "read",
              "path": "height"
            },
            "fit": "cover",
            "alpha": {
              "op": "sub",
              "args": [
                1,
                {
                  "op": "read",
                  "path": "defs.q"
                }
              ]
            }
          },
          {
            "op": "image",
            "input": "to",
            "x": 0,
            "y": 0,
            "width": {
              "op": "read",
              "path": "width"
            },
            "height": {
              "op": "read",
              "path": "height"
            },
            "fit": "cover",
            "alpha": {
              "op": "read",
              "path": "defs.q"
            },
            "blend": "lighter"
          }
        ],
        "x": {
          "op": "mul",
          "args": [
            {
              "op": "read",
              "path": "width"
            },
            {
              "op": "sub",
              "args": [
                1,
                {
                  "op": "read",
                  "path": "defs.z"
                }
              ]
            },
            {
              "op": "div",
              "args": [
                {
                  "op": "read",
                  "path": "controls.focusX"
                },
                100
              ]
            }
          ]
        },
        "y": {
          "op": "mul",
          "args": [
            {
              "op": "read",
              "path": "height"
            },
            {
              "op": "sub",
              "args": [
                1,
                {
                  "op": "read",
                  "path": "defs.z"
                }
              ]
            },
            {
              "op": "div",
              "args": [
                {
                  "op": "read",
                  "path": "controls.focusY"
                },
                100
              ]
            }
          ]
        },
        "scaleX": {
          "op": "read",
          "path": "defs.z"
        },
        "scaleY": {
          "op": "read",
          "path": "defs.z"
        }
      }
    ]
  }
}
