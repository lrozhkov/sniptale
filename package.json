{
  "name": "sniptale",
  "private": true,
  "version": "0.4.0",
  "description": "Snip the web. Tell the story.",
  "license": "AGPL-3.0-or-later",
  "author": "Lev Rozhkov",
  "homepage": "https://github.com/lrozhkov/sniptale#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lrozhkov/sniptale.git"
  },
  "bugs": {
    "url": "https://github.com/lrozhkov/sniptale/issues"
  },
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.18.0 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/extension",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/extension/vite.config.ts",
    "prepare": "husky",
    "typecheck": "node tooling/qa/proof/typecheck/execution/check.mjs",
    "lint": "node tooling/qa/guards/quality/verify-oxlint.mjs",
    "lint:fix": "node tooling/qa/guards/quality/verify-oxlint.mjs --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:coverage:profile": "node tooling/qa/proof/coverage/profile-full-coverage.mjs",
    "format": "node tooling/qa/guards/quality/verify-oxfmt.mjs",
    "format:write": "node tooling/qa/guards/quality/verify-oxfmt.mjs --write",
    "docs:generate": "node tooling/qa/policy/documentation/generate-documentation-facts.mjs",
    "qa:preflight": "node tooling/qa/wrappers/preflight.mjs",
    "qa:advisory": "node tooling/qa/wrappers/advisory.mjs",
    "qa:structural-audit": "node tooling/qa/wrappers/structural-audit.mjs",
    "qa:checkpoint": "node tooling/qa/wrappers/checkpoint.mjs",
    "qa:closeout": "node tooling/qa/wrappers/closeout.mjs",
    "qa:internal:build": "node tooling/qa/wrappers/build.mjs",
    "qa:release-harness": "node tooling/qa/wrappers/release-harness.mjs",
    "qa:stats": "node tooling/qa/runtime/observability/report.mjs",
    "qa:e2e": "node tooling/test/e2e/run-e2e.mjs --suite smoke",
    "qa:e2e:smoke": "node tooling/test/e2e/run-e2e.mjs --suite smoke",
    "qa:e2e:critical": "node tooling/test/e2e/run-e2e.mjs --suite critical",
    "qa:e2e:security": "node tooling/test/e2e/run-e2e.mjs --suite security",
    "qa:e2e:all": "node tooling/test/e2e/run-e2e.mjs --suite all",
    "qa:e2e:headed": "npm run qa:e2e:smoke:headed",
    "qa:e2e:smoke:headed": "node tooling/test/e2e/run-e2e.mjs --suite smoke --headed",
    "qa:e2e:critical:headed": "node tooling/test/e2e/run-e2e.mjs --suite critical --headed",
    "qa:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers npm exec playwright install chromium",
    "qa:e2e:install:deps": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers npm exec playwright install-deps chromium",
    "qa:archive-stress": "tsx tooling/test/stress/media-archive-profile.ts",
    "qa:archive-certify": "tsx tooling/test/stress/media-archive-profile.ts --certify",
    "qa:e2e:build": "vite build --config apps/extension/vite.config.ts --mode test-e2e",
    "qa:e2e:build:release": "SNIPTALE_RELEASE_E2E_OUTPUT=1 vite build --config apps/extension/vite.config.ts --mode release",
    "qa:e2e:build:security": "vite build --config apps/extension/vite.config.ts --mode security-e2e",
    "web-snapshot:smoke": "npm run build && node tooling/web-snapshot-smoke/runtime/polygon-runner.mjs",
    "qa:raw:oxlint": "node tooling/qa/guards/quality/verify-oxlint.mjs",
    "qa:raw:oxfmt": "node tooling/qa/guards/quality/verify-oxfmt.mjs",
    "qa:raw:typecheck": "node tooling/qa/proof/typecheck/execution/check.mjs",
    "qa:raw:vitest": "vitest run",
    "qa:raw:depcruise": "depcruise --config .dependency-cruiser.cjs apps/extension/src packages/foundation/src packages/runtime-contracts/src packages/platform/src packages/ui/src",
    "qa:raw:vite": "vite build --config apps/extension/vite.config.ts",
    "qa:raw:playwright": "npm exec playwright",
    "qa:raw:ast-grep": "ast-grep",
    "qa:raw:knip": "knip --config tooling/configs/qa/knip.json",
    "qa:raw:codeql": "codeql",
    "ci:proof": "node tooling/ci/proof.mjs",
    "ci:release": "node tooling/ci/local.mjs release",
    "ci:proof:container": "node tooling/ci/local-container.mjs proof",
    "ci:release:container": "node tooling/ci/local-container.mjs release",
    "ci:build": "npm run build",
    "ci:github:plan": "node tooling/ci/github-policy.mjs plan",
    "ci:github:apply": "node tooling/ci/github-policy.mjs apply",
    "ci:github:restore": "node tooling/ci/github-policy.mjs restore",
    "ci:dependencies:plan": "node tooling/ci/dependency-freshness.mjs",
    "agents:install": "node tooling/agent-tooling/install.mjs",
    "agents:remove": "node tooling/agent-tooling/remove.mjs",
    "backup:repo": "bash tooling/backup/sc-backup.sh",
    "backup:prod": "bash tooling/backup/sc-prod-backup.sh",
    "build": "vite build --config apps/extension/vite.config.ts",
    "build:release": "vite build --config apps/extension/vite.config.ts --mode release",
    "release:legal": "node tooling/release/dependency-legal/generate-dependency-legal.mjs",
    "release:package-only": "node tooling/qa/proof/typecheck/execution/check.mjs && npm run build:release && node tooling/release/package/package-dist.mjs",
    "preview": "vite preview --config apps/extension/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/marck-script": "5.3.0",
    "@iconify-icons/tabler": "^2.0.0",
    "@iconify/react": "^6.0.2",
    "@noble/hashes": "2.4.0",
    "@webav/mp4box.js": "^0.5.7",
    "@zip.js/zip.js": "^2.8.61",
    "@zumer/snapdom": "2.24.7",
    "dompurify": "^3.4.14",
    "fabric": "^7.4.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "mediabunny": "^1.55.2",
    "mp4-muxer": "^5.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "roughjs": "^4.6.6",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.45.1",
    "@bcoe/v8-coverage": "^1.0.2",
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.62.1",
    "@sniptale/platform": "0.4.0",
    "@sniptale/runtime-contracts": "0.4.0",
    "@sniptale/ui": "0.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jscpd": "5.0.16",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tinyglobby": "^0.2.17",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.3",
    "yaml": "2.9.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "@babel/core": "^7.29.7",
    "js-yaml": "^4.3.0",
    "tar": "^7.5.8",
    "esbuild": "^0.28.2",
    "flatted": "^3.4.4",
    "rollup": "^4.62.5",
    "undici": "^7.24.0",
    "@rollup/pluginutils": {
      "picomatch": "^2.3.2"
    },
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "micromatch": {
      "picomatch": "^2.3.2"
    },
    "readdirp": {
      "picomatch": "^2.3.2"
    },
    "dependency-cruiser": {
      "picomatch": "^4.0.5"
    },
    "fdir": {
      "picomatch": "^4.0.5"
    },
    "tinyglobby": {
      "picomatch": "^4.0.5"
    },
    "vite": {
      "picomatch": "^4.0.5"
    },
    "vitest": {
      "picomatch": "^4.0.5"
    }
  }
}
