{
  "name": "sniptale",
  "private": true,
  "version": "0.3.3",
  "description": "Snip the web. Tell the story.",
  "license": "AGPL-3.0-or-later",
  "author": "Lev Rozhkov",
  "homepage": "https://github.com/lrozhkov/sniptale#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/lrozhkov/sniptale.git"
  },
  "bugs": {
    "url": "https://github.com/lrozhkov/sniptale/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "workspaces": [
    "apps/extension",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/extension/vite.config.ts",
    "prepare": "husky",
    "typecheck": "node tooling/qa/core/verify-typecheck.mjs",
    "lint": "node tooling/qa/core/verify-oxlint.mjs",
    "lint:fix": "node tooling/qa/core/verify-oxlint.mjs --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "format": "node tooling/qa/core/verify-oxfmt.mjs",
    "format:write": "node tooling/qa/core/verify-oxfmt.mjs --write",
    "docs:generate": "node tooling/qa/core/generate-documentation-facts.mjs",
    "qa:preflight": "node tooling/qa/wrappers/preflight.mjs",
    "qa:advisory": "node tooling/qa/wrappers/advisory.mjs",
    "qa:structural-audit": "node tooling/qa/wrappers/structural-audit.mjs",
    "qa:checkpoint": "node tooling/qa/wrappers/checkpoint.mjs",
    "qa:closeout": "node tooling/qa/wrappers/closeout.mjs",
    "qa:internal:build": "node tooling/qa/wrappers/build.mjs",
    "qa:release-harness": "node tooling/qa/wrappers/release-harness.mjs",
    "qa:stats": "node tooling/qa/runtime/observability/report.mjs",
    "qa:e2e": "node tooling/test/e2e/run-e2e.mjs --suite smoke",
    "qa:e2e:smoke": "node tooling/test/e2e/run-e2e.mjs --suite smoke",
    "qa:e2e:critical": "node tooling/test/e2e/run-e2e.mjs --suite critical",
    "qa:e2e:security": "node tooling/test/e2e/run-e2e.mjs --suite security",
    "qa:e2e:all": "node tooling/test/e2e/run-e2e.mjs --suite all",
    "qa:e2e:headed": "npm run qa:e2e:smoke:headed",
    "qa:e2e:smoke:headed": "node tooling/test/e2e/run-e2e.mjs --suite smoke --headed",
    "qa:e2e:critical:headed": "node tooling/test/e2e/run-e2e.mjs --suite critical --headed",
    "qa:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers npm exec playwright install chromium",
    "qa:e2e:install:deps": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers npm exec playwright install-deps chromium",
    "qa:archive-stress": "tsx tooling/test/stress/media-archive-profile.ts",
    "qa:archive-certify": "tsx tooling/test/stress/media-archive-profile.ts --certify",
    "qa:e2e:build": "vite build --config apps/extension/vite.config.ts --mode test-e2e",
    "qa:e2e:build:release": "SNIPTALE_RELEASE_E2E_OUTPUT=1 vite build --config apps/extension/vite.config.ts --mode release",
    "qa:e2e:build:security": "vite build --config apps/extension/vite.config.ts --mode security-e2e",
    "qa:raw:oxlint": "node tooling/qa/core/verify-oxlint.mjs",
    "qa:raw:oxfmt": "node tooling/qa/core/verify-oxfmt.mjs",
    "qa:raw:typecheck": "node tooling/qa/core/verify-typecheck.mjs",
    "qa:raw:vitest": "vitest run",
    "qa:raw:depcruise": "depcruise --config .dependency-cruiser.cjs apps/extension/src apps/extension/build apps/extension/vite.config.ts packages tooling",
    "qa:raw:vite": "vite build --config apps/extension/vite.config.ts",
    "qa:raw:playwright": "npm exec playwright",
    "qa:raw:ast-grep": "ast-grep",
    "qa:raw:knip": "knip",
    "qa:raw:semgrep": "semgrep",
    "qa:raw:codeql": "codeql",
    "ci:proof": "node tooling/ci/proof.mjs",
    "ci:release": "node tooling/ci/local.mjs release",
    "ci:build": "npm run build",
    "ci:github:plan": "node tooling/ci/github-policy.mjs plan",
    "ci:github:apply": "node tooling/ci/github-policy.mjs apply",
    "ci:github:restore": "node tooling/ci/github-policy.mjs restore",
    "agents:install": "node tooling/agent-tooling/install.mjs",
    "agents:remove": "node tooling/agent-tooling/remove.mjs",
    "backup:repo": "bash tooling/backup/sc-backup.sh",
    "backup:prod": "bash tooling/backup/sc-prod-backup.sh",
    "build": "node tooling/qa/core/verify-typecheck.mjs && vite build --config apps/extension/vite.config.ts",
    "build:release": "vite build --config apps/extension/vite.config.ts --mode release",
    "release:legal": "node tooling/release/generate-dependency-legal.mjs",
    "release:package-only": "node tooling/qa/core/verify-typecheck.mjs && npm run build:release && node tooling/release/package-dist.mjs",
    "preview": "vite preview --config apps/extension/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/marck-script": "5.3.0",
    "@iconify-icons/tabler": "^1.2.95",
    "@iconify/react": "^6.0.2",
    "@webav/mp4box.js": "^0.5.7",
    "@zip.js/zip.js": "^2.8.53",
    "@zumer/snapdom": "2.23.2",
    "dompurify": "^3.4.12",
    "fabric": "^7.4.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "mediabunny": "^1.46.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "roughjs": "^4.6.6",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.42.1",
    "@crxjs/vite-plugin": "^2.7.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@playwright/test": "^1.62.1",
    "@sniptale/platform": "0.3.3",
    "@sniptale/runtime-contracts": "0.3.3",
    "@sniptale/ui": "0.3.3",
    "@types/chrome": "^0.1.36",
    "@types/node": "^20.11.24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.18",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jscpd": "^4.0.8",
    "jsdom": "^26.1.0",
    "knip": "^6.3.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-morph": "^27.0.2",
    "tsx": "^4.22.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "ws": "^8.20.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "@babel/core": "^7.29.7",
    "js-yaml": "^4.3.0",
    "tar": "^7.5.8",
    "esbuild": "^0.28.1",
    "flatted": "^3.4.2",
    "rollup": "^4.59.0",
    "undici": "^7.24.0",
    "@rollup/pluginutils": {
      "picomatch": "^2.3.2"
    },
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "micromatch": {
      "picomatch": "^2.3.2"
    },
    "readdirp": {
      "picomatch": "^2.3.2"
    },
    "dependency-cruiser": {
      "picomatch": "^4.0.4"
    },
    "fdir": {
      "picomatch": "^4.0.4"
    },
    "tinyglobby": {
      "picomatch": "^4.0.4"
    },
    "vite": {
      "picomatch": "^4.0.4"
    },
    "vitest": {
      "picomatch": "^4.0.4"
    }
  }
}
